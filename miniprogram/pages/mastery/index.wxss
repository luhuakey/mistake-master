.mastery-page { min-height:100vh; box-sizing:border-box; padding-bottom:130rpx; background:radial-gradient(circle at 5% 48%,rgba(42,224,193,.09),transparent 31%),#fbfefd; }
.mastery-content { padding:12rpx 0 130rpx; }
.subject-segment-scroll { width:auto; height:78rpx; margin:12rpx 0 16rpx; white-space:nowrap; }
.subject-segment { min-width:100%; height:66rpx; box-sizing:border-box; display:inline-flex; gap:5rpx; padding:6rpx; border-radius:34rpx; background:#edf5f4; }
.subject-option { flex:none; min-width:112rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; padding:0 22rpx; border-radius:28rpx; color:#667276; font-size:25rpx; font-weight:600; white-space:nowrap; transition:color .18s ease,background-color .18s ease,box-shadow .18s ease; }
.subject-option.active { color:#078f8a; background:#fff; box-shadow:0 5rpx 16rpx rgba(0,140,135,.11); }
.radar-wrap { position:relative; width:100%; margin:0 auto 12rpx; }
.radar { position:absolute; }
.radar-label { position:absolute; width:180rpx; overflow:hidden; color:#111516; font-size:25rpx; line-height:1.2; text-align:center; text-overflow:ellipsis; white-space:nowrap; transform:translate(-50%,-50%); }

.mastery-row { display:flex; align-items:center; gap:24rpx; min-height:94rpx; box-sizing:border-box; margin-bottom:20rpx; padding:22rpx 30rpx; }
.name { width:220rpx; overflow:hidden; color:#090d0e; font-size:29rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.bar { flex:1; height:22rpx; overflow:hidden; border-radius:14rpx; background:var(--status-mastered-soft); }
.bar.weak-bar { background:var(--status-unmastered-soft); }
.fill { height:100%; border-radius:14rpx; background:linear-gradient(90deg,#12c8ae,var(--status-mastered)); }
.fill.weak { background:linear-gradient(90deg,#ffac2f,var(--status-unmastered)); }
.rate { width:88rpx; display:flex; flex-direction:column; align-items:flex-end; color:var(--status-mastered); }
.rate text:first-child { font-size:31rpx; }
.rate text:last-child { font-size:19rpx; }
.weak-text { color:var(--status-unmastered); }

.notice { position:fixed; z-index:6; right:38rpx; bottom:calc(env(safe-area-inset-bottom) + 26rpx); left:38rpx; height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:40rpx; color:#3b4649; background:rgba(255,255,255,.98); box-shadow:0 12rpx 34rpx rgba(0,165,160,.10); font-size:23rpx; }
.notice text { color:#078f8a; }
.pin { width:28rpx; height:28rpx; display:flex; align-items:center; justify-content:center; margin-right:14rpx; border:3rpx solid #aeb5b7; border-radius:50%; color:#aeb5b7; font-size:8rpx; }
