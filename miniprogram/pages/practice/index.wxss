.practice-page { padding-bottom:calc(145rpx + env(safe-area-inset-bottom)); }
.practice-preparing { display:flex; flex-direction:column; align-items:center; margin-top:38rpx; padding:76rpx 38rpx 62rpx; text-align:center; }
.preparing-visual { position:relative; width:150rpx; height:150rpx; display:flex; align-items:center; justify-content:center; margin-bottom:34rpx; }
.preparing-orbit { position:absolute; inset:0; box-sizing:border-box; border:4rpx solid transparent; border-radius:50%; }
.orbit-one { border-top-color:#11bea9; border-right-color:rgba(17,190,169,.22); animation:practice-orbit 1.15s linear infinite; }
.orbit-two { inset:18rpx; border-bottom-color:#08a9c4; border-left-color:rgba(8,169,196,.2); animation:practice-orbit-reverse .9s linear infinite; }
.preparing-core { width:74rpx; height:74rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:linear-gradient(135deg,#1ad2a6,#08a7c7); box-shadow:0 12rpx 30rpx rgba(7,169,162,.22); font-size:31rpx; animation:practice-core-pulse 1.25s ease-in-out infinite; }
.preparing-title { color:#172021; font-size:31rpx; font-weight:800; }
.preparing-description { margin-top:15rpx; color:#526f6d; font-size:24rpx; line-height:1.55; }
.preparing-dots { height:32rpx; display:flex; align-items:center; gap:10rpx; margin-top:19rpx; }
.preparing-dots text { width:9rpx; height:9rpx; border-radius:50%; background:#11bca8; animation:practice-dot 1.05s ease-in-out infinite; }
.preparing-dots text:nth-child(2) { animation-delay:.14s; }
.preparing-dots text:nth-child(3) { animation-delay:.28s; }
.preparing-hint { margin-top:8rpx; color:#8a9897; font-size:20rpx; }
@keyframes practice-orbit { to { transform:rotate(360deg); } }
@keyframes practice-orbit-reverse { to { transform:rotate(-360deg); } }
@keyframes practice-core-pulse { 50% { transform:scale(.9); box-shadow:0 7rpx 18rpx rgba(7,169,162,.14); } }
@keyframes practice-dot { 0%,100% { opacity:.28; transform:translateY(0); } 50% { opacity:1; transform:translateY(-7rpx); } }
.progress-block { margin:24rpx 0 24rpx; }
.progress-meta { display:flex; align-items:center; justify-content:space-between; margin-bottom:14rpx; }
.progress-count { color:#526063; font-size:24rpx; font-weight:500; }
.progress-percent { color:#078f8a; font-size:27rpx; font-weight:700; }
.progress { width:100%; height:13rpx; overflow:hidden; border-radius:10rpx; background:#e8ecec; }
.progress-bar { height:100%; border-radius:10rpx; background:linear-gradient(90deg,#14c8aa,#05a6d8); }
.recommendation-note { display:flex; align-items:flex-start; gap:16rpx; margin:0 0 24rpx; padding:19rpx 22rpx; border:1rpx solid #ccebe6; border-radius:20rpx; color:#386c69; background:#effaf8; }
.recommendation-note-icon { flex:none; width:34rpx; height:34rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:linear-gradient(135deg,#16c9a8,#08a8c8); font-size:20rpx; }
.recommendation-note-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:6rpx; }
.recommendation-note-title { color:#167d78; font-size:22rpx; font-weight:800; }
.recommendation-note-text { color:#526f6d; font-size:20rpx; line-height:1.5; }
.recommendation-setting-path { color:#078f8a; font-size:19rpx; line-height:1.45; }

.question { min-height:292rpx; box-sizing:border-box; padding:34rpx; }
.question-meta { display:flex; align-items:center; justify-content:space-between; color:#078f8a; font-size:27rpx; font-weight:600; }
.question-meta text:last-child { padding:10rpx 18rpx; border-radius:13rpx; background:#e8fbf9; font-weight:400; }
.stem { margin-top:48rpx; color:#15191a; font-size:31rpx; line-height:1.75; font-weight:500; text-align:center; }
.question-illustration { margin-top:24rpx; padding:12rpx; overflow:hidden; border:2rpx solid #dce9e6; border-radius:16rpx; background:#f8fbfa; }
.question-illustration { text-align:center; }
.question-illustration image { width:auto; max-width:100%; display:inline-block; border-radius:10rpx; }
.question-illustration text { display:block; margin-top:10rpx; color:#718082; text-align:center; font-size:19rpx; }

.options { margin-top:58rpx; }
.option { min-height:95rpx; box-sizing:border-box; display:flex; align-items:center; gap:24rpx; margin:22rpx 0; padding:18rpx 28rpx; border:3rpx solid #d2d6d6; border-radius:29rpx; color:#586366; background:#fff; font-size:27rpx; }
.option.selected { color:#008f8b; border-color:#8de3dc; background:linear-gradient(90deg,#edfcfa,#e3fbf8); }
.option.disabled { pointer-events:none; opacity:.72; }
.letter { flex:none; width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#f4f6f6; color:#313839; font-size:29rpx; }
.selected .letter { color:#fff; background:linear-gradient(135deg,#0ab9b1,#07a4d8); }
.option-text { flex:1; line-height:1.4; }
.circle { flex:none; width:38rpx; height:38rpx; box-sizing:border-box; border:3rpx solid #c4c9c9; border-radius:50%; }
.selected .circle { border:9rpx solid #08aaa5; }
.multiple-hint { display:block; margin:10rpx 8rpx 0; color:#70807f; font-size:21rpx; line-height:1.5; }

.text-answer-card { margin-top:42rpx; padding:30rpx; border-radius:28rpx; background:#fff; box-shadow:0 14rpx 38rpx rgba(0,169,163,.09); }
.text-answer-label { display:block; color:#172021; font-size:27rpx; font-weight:700; }
.text-answer-input { width:100%; min-height:88rpx; box-sizing:border-box; margin-top:20rpx; padding:22rpx 26rpx; border:3rpx solid #cfe4e1; border-radius:22rpx; color:#172021; background:#f8fcfb; font-size:30rpx; line-height:1.55; }
.long-answer-input { min-height:260rpx; }
.text-answer-input:focus { border-color:#08aaa5; }
.text-answer-hint { display:block; margin-top:14rpx; color:#81908f; font-size:21rpx; }

.practice-actions { position:fixed; z-index:8; right:38rpx; bottom:calc(env(safe-area-inset-bottom) + 26rpx); left:38rpx; display:flex; justify-content:center; gap:18rpx; }
.previous { width:100%; height:84rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:2rpx solid #c9ebe6; border-radius:44rpx; color:#078f8a; background:rgba(245,253,252,.98); box-shadow:0 14rpx 34rpx rgba(0,140,135,.12); font-size:27rpx; font-weight:700; }
.answer-next { width:100%; height:84rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border-radius:44rpx; color:#fff; background:linear-gradient(105deg,#21d6a2,#04aaa9); box-shadow:0 14rpx 34rpx rgba(0,174,169,.18); font-size:27rpx; font-weight:700; }
.action-half { width:50%; }
.submit-retry { position:fixed; z-index:8; right:38rpx; bottom:calc(env(safe-area-inset-bottom) + 26rpx); left:38rpx; height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:46rpx; color:#fff; background:linear-gradient(105deg,#21d6a2,#04aaa9); box-shadow:0 16rpx 36rpx rgba(0,174,169,.18); font-size:28rpx; font-weight:700; }
.previous.disabled, .answer-next.disabled { pointer-events:none; opacity:.48; }
.start-action { width:300rpx; height:80rpx; display:flex; align-items:center; justify-content:center; margin:30rpx auto 0; border-radius:42rpx; color:#fff; background:linear-gradient(105deg,#21d6a2,#04aaa9); }
