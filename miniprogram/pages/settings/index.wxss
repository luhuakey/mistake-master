.settings-page { min-height:100vh; padding-bottom:calc(80rpx + env(safe-area-inset-bottom)); }
.settings-page.subject-drag-active { overscroll-behavior:none; }
.settings-section { margin-bottom:24rpx; padding:0 30rpx; }
.section-title { display:block; padding:28rpx 0 18rpx; color:#12191a; font-size:29rpx; font-weight:800; }
.section-description { display:block; margin:-8rpx 0 22rpx; color:#738083; font-size:22rpx; line-height:1.5; }
.setting-item,.picker-row { min-height:116rpx; display:flex; align-items:center; gap:22rpx; border-top:1rpx solid #ebf0ef; }
.setting-copy { min-width:0; flex:1; display:flex; flex-direction:column; gap:8rpx; }
.setting-title { color:#182021; font-size:26rpx; font-weight:700; }
.setting-description { color:#748083; font-size:21rpx; line-height:1.45; }
.picker-value { flex:none; display:flex; align-items:center; gap:10rpx; color:#078f8a; font-size:24rpx; font-weight:700; }
.picker-arrow { color:#09a58b; font-family:Arial,sans-serif; font-size:42rpx; font-weight:300; }
.difficulty-setting { padding:25rpx 0 24rpx; border-top:1rpx solid #ebf0ef; }
.difficulty-heading { display:flex; flex-direction:column; gap:8rpx; margin-bottom:18rpx; }
.difficulty-options { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.difficulty-option { min-width:0; box-sizing:border-box; padding:18rpx; border:2rpx solid #dfe9e8; border-radius:18rpx; background:#f8fbfb; transition:border-color .18s ease,background-color .18s ease,box-shadow .18s ease,transform .18s ease; }
.difficulty-option.active { border-color:#20bfae; background:#ebfaf7; box-shadow:0 7rpx 18rpx rgba(7,163,151,.1); transform:translateY(-2rpx); }
.difficulty-option-head { display:flex; align-items:center; gap:8rpx; }
.difficulty-radio { flex:none; width:20rpx; height:20rpx; box-sizing:border-box; border:3rpx solid #aebcba; border-radius:50%; background:#fff; }
.difficulty-option.active .difficulty-radio { border:6rpx solid #09ac9d; }
.difficulty-label { color:#263031; font-size:23rpx; font-weight:800; }
.recommended-badge { padding:3rpx 8rpx; border-radius:10rpx; color:#078f8a; background:#dff7f3; font-size:17rpx; }
.difficulty-description { display:block; margin:11rpx 0 0 28rpx; color:#73817f; font-size:19rpx; line-height:1.5; }
.ai-note { margin:4rpx 0 28rpx; padding:18rpx 20rpx; border-radius:16rpx; color:#34716d; background:#ecfaf7; font-size:21rpx; line-height:1.6; }
.subject-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; padding-bottom:30rpx; }
.subject-chip { position:relative; z-index:0; min-width:0; height:70rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:7rpx; border:2rpx solid #dce9e7; border-radius:22rpx; color:#566366; background:#f8fbfb; font-size:23rpx; transition:box-shadow .18s ease,transform .18s ease,background-color .18s ease; }
.subject-chip.active { border-color:#2cc8b5; color:#078f8a; background:#e8faf7; font-weight:700; }
.subject-chip.dragging { z-index:5; border-color:#11bba7; background:#f3fffd; box-shadow:0 18rpx 38rpx rgba(3,147,141,.25); transform:translateY(-9rpx) scale(1.075); animation:subject-chip-float .72s ease-in-out infinite alternate; touch-action:none; }
.subject-check { width:18rpx; color:#06ab91; font-size:20rpx; }
@keyframes subject-chip-float {
  0% { transform:translateY(-7rpx) scale(1.06) rotate(-.5deg); }
  100% { transform:translateY(-11rpx) scale(1.08) rotate(.5deg); }
}
.save-button { width:100%; height:88rpx; display:flex; align-items:center; justify-content:center; margin:38rpx 0 0; border:0; border-radius:44rpx; color:#fff; background:linear-gradient(100deg,#16d19f,#08a8c8); box-shadow:0 14rpx 30rpx rgba(5,171,162,.2); font-size:29rpx; font-weight:800; line-height:88rpx; }
.save-button::after { border:0; }
.save-button[disabled] { opacity:.68; }
