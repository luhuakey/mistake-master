.history-page { padding-bottom:70rpx; }

.checkin-card { box-sizing:border-box; margin-top:24rpx; padding:28rpx 26rpx 30rpx; }
.checkin-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:18rpx; }
.checkin-title { color:#101617; font-size:30rpx; font-weight:800; }
.checkin-all { padding:10rpx 18rpx; border-radius:22rpx; color:#058f7f; background:#e8f8f5; font-size:22rpx; font-weight:600; }
.checkin-month-nav { display:flex; align-items:center; justify-content:space-between; margin-bottom:18rpx; }
.checkin-month-btn { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; color:#058f7f; background:#e8f8f5; font-family:Arial,sans-serif; font-size:44rpx; line-height:1; }
.checkin-month-label { color:#111516; font-size:28rpx; font-weight:700; }
.checkin-weekdays { display:flex; padding:0 4rpx 10rpx; }
.checkin-weekdays text { flex:1; color:#8a9394; text-align:center; font-size:20rpx; }
.checkin-weeks { display:flex; flex-direction:column; gap:8rpx; }
.checkin-week { display:flex; }
.checkin-cell { flex:1; min-width:0; height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; }
.checkin-cell.is-selected { background:#dff6f1; }
.checkin-day { min-width:46rpx; height:46rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#9aa3a4; font-size:24rpx; }
.checkin-cell.is-current .checkin-day { color:#242829; }
.checkin-day.is-marked { position:relative; color:#087f7a; font-weight:800; }
.checkin-day.is-marked::after { position:absolute; bottom:1rpx; width:8rpx; height:8rpx; border-radius:50%; background:#ff9e3d; content:""; }
.checkin-cell.is-selected .checkin-day { color:#fff; background:#09a98e; }
.checkin-cell.is-selected .checkin-day.is-marked::after { bottom:0; background:#ffd477; }
.checkin-loading { padding:30rpx 0; color:#7d8889; text-align:center; font-size:23rpx; }

.history-summary { display:flex; align-items:stretch; padding:36rpx 18rpx; margin:24rpx 0 42rpx; border-radius:32rpx; color:#fff; background:linear-gradient(110deg,#079fe5,#26d994); box-shadow:0 18rpx 42rpx rgba(0,172,184,.18); }
.summary-item { min-width:0; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; border-right:1rpx solid rgba(255,255,255,.38); }
.summary-item:last-child { border:0; }
.summary-label { font-size:23rpx; font-weight:700; }
.summary-value { min-height:58rpx; display:flex; align-items:baseline; justify-content:center; line-height:1; }
.summary-number { font-size:49rpx; font-weight:800; }
.summary-unit { margin-left:5rpx; font-size:24rpx; font-weight:500; }

.record { position:relative; min-height:168rpx; box-sizing:border-box; display:flex; align-items:flex-start; gap:24rpx; margin-bottom:28rpx; padding:34rpx 34rpx 45rpx; }
.time { flex:none; display:flex; flex-direction:column; gap:10rpx; color:#0c1011; font-size:27rpx; }
.time text:last-child { color:#626d70; font-size:24rpx; }
.info { flex:1; display:flex; flex-direction:column; align-items:flex-start; gap:10rpx; }
.type { padding:9rpx 21rpx; border-radius:13rpx; color:#fff; background:#06aaa4; font-size:24rpx; font-weight:700; }
.type.review { background:#ff861e; }
.subject-label { color:#111516; font-size:27rpx; font-weight:700; }
.accuracy { align-self:center; color:#079f99; font-size:34rpx; font-weight:700; }
.arrow { align-self:center; color:#929b9e; font-family:Arial,sans-serif; font-size:50rpx; }
.record-line { position:absolute; right:34rpx; bottom:20rpx; left:34rpx; display:flex; align-items:center; gap:20rpx; }
.accuracy-track { min-width:0; height:6rpx; flex:1; overflow:hidden; border-radius:6rpx; background:#ef5656; }
.accuracy-progress { height:100%; border-radius:6rpx 0 0 6rpx; background:#16bd70; transition:width .3s ease; }
.record-line text { flex:none; color:#5d686b; font-size:20rpx; }
