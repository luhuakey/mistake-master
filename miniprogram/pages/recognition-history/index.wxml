<view class="page recognition-history-page">
  <view class="page-nav-shell {{navScrolled?'nav-scrolled':''}}" style="{{navShellStyle}}">
    <view class="nav" style="{{navBarStyle}}"><text class="nav-back" bindtap="back">‹</text><text class="nav-title">拍照识别记录</text></view>
  </view>

  <view class="history-intro card">
    <view><text class="intro-number">{{items.length}}</text><text class="intro-unit">道</text></view>
    <text class="intro-title">已保存的拍照错题</text>
    <text class="intro-description">按识别保存时间倒序排列，点击可查看题目详情</text>
  </view>

  <view wx:if="{{loading}}" class="loading"><app-loading tips="加载记录"/></view>
  <view wx:elif="{{!items.length}}" class="empty card">
    <text class="empty-title">暂无拍照识别记录</text>
    <text class="empty-copy">完成拍照识别并保存后，错题会出现在这里</text>
    <button class="capture-button" bindtap="capture">去拍照录入</button>
  </view>
  <view wx:else class="record-list">
    <view wx:for="{{items}}" wx:key="id" class="record-item">
      <view class="record-time"><text>{{item.dateLabel}}</text><text>拍照识别</text></view>
      <question-card question="{{item}}" bind:select="openQuestion"/>
    </view>
  </view>
</view>
