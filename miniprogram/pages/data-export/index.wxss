.export-page { padding-bottom:70rpx; }
.export-hero { display:flex; flex-direction:column; align-items:center; margin-top:20rpx; padding:44rpx 38rpx; text-align:center; background:linear-gradient(145deg,#eafff8,#eefaff); }
.export-icon { width:90rpx; height:90rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:linear-gradient(135deg,#20d5a0,#08a5dc); box-shadow:0 12rpx 30rpx rgba(7,176,174,.2); }
.export-icon text { font-size:54rpx; line-height:1; }
.export-title { margin-top:24rpx; color:#142021; font-size:32rpx; font-weight:800; }
.export-copy { margin-top:14rpx; color:#607174; font-size:22rpx; line-height:1.7; }
.export-summary { display:flex; align-items:center; margin-top:26rpx; padding:28rpx; }
.export-summary>view:not(.summary-divider) { flex:1; display:flex; flex-direction:column; align-items:center; gap:8rpx; }
.summary-number { color:#079f99; font-size:42rpx; font-weight:800; }
.summary-label { color:#667579; font-size:22rpx; }
.summary-divider { width:1rpx; height:64rpx; background:#dcebea; }
.format-card { margin-top:26rpx; padding:30rpx; }
.format-title { display:block; margin-bottom:12rpx; font-size:27rpx; font-weight:800; }
.format-row { display:flex; align-items:center; gap:20rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f1; }
.format-row:last-child { border:0; }
.format-badge { width:70rpx; box-sizing:border-box; padding:8rpx 0; border-radius:10rpx; color:#fff; background:#09aaa2; font-size:20rpx; font-weight:800; text-align:center; }
.format-badge.secondary { background:#12a3dc; }
.format-row>view { min-width:0; flex:1; }
.format-row>view text { display:block; color:#263234; font-size:24rpx; font-weight:700; }
.format-row>view text:last-child { margin-top:6rpx; color:#7a878a; font-size:19rpx; font-weight:400; line-height:1.5; }
.check { color:#08aa89; font-size:30rpx; font-weight:800; }
.success-note { margin:24rpx 8rpx 0; color:#078f7d; font-size:21rpx; text-align:center; }
.export-button { height:86rpx; display:flex; align-items:center; justify-content:center; margin-top:30rpx; border:0; border-radius:44rpx; color:#fff; background:linear-gradient(100deg,#22d5a0,#079fe6); box-shadow:0 14rpx 32rpx rgba(0,174,188,.16); font-size:29rpx; font-weight:700; }
.export-button::after { border:0; }
.export-button[disabled] { color:#fff; opacity:.65; }
.privacy-note { display:block; margin-top:18rpx; color:#879294; font-size:20rpx; text-align:center; }
