page {
  background: #fbfefd;
}

.home-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 0;
  color: #15191b;
  background:
    radial-gradient(circle at 6% 24%, rgba(64, 231, 199, 0.12), transparent 28%),
    radial-gradient(circle at 96% 48%, rgba(30, 192, 224, 0.08), transparent 30%),
    #fbfefd;
}

.home-header {
  position: relative;
  flex: none;
  z-index: 30;
  top: 0;
  box-sizing: content-box;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  background: rgba(251, 254, 253, .96);
  transition: box-shadow .2s ease, background-color .2s ease;
}

.home-header.nav-scrolled {
  background: rgba(251, 254, 253, .985);
  box-shadow: 0 10rpx 28rpx rgba(23, 82, 79, .08);
}

.home-identity {
  position: absolute;
  left: 38rpx;
  bottom: 10rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  gap: 11rpx;
  border-radius: 34rpx;
}

.home-identity.guest-identity {
  padding-right: 18rpx;
  background: #edf9f7;
  box-shadow: inset 0 0 0 1rpx rgba(8, 167, 160, .1);
}

.home-identity:active { opacity: .72; }

.avatar {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #e7ebeb;
}

.guest-identity-label {
  color: #087f7a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.home-title {
  max-width: 360rpx;
  overflow: hidden;
  color: #070909;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.home-content {
  min-height: 100%;
  box-sizing: border-box;
  padding: 0 38rpx calc(150rpx + env(safe-area-inset-bottom));
}

.home-navigation-shell { flex:none; padding:0 38rpx; background:#fbfefd; }
.home-data-scroll { min-height:0; flex:1; height:auto; }
.home-navigation-shell .subject-nav-sticky {
  border-bottom: 1rpx solid rgba(218, 234, 232, .72);
  box-shadow: 0 10rpx 24rpx rgba(23, 82, 79, .055);
}
.home-navigation-shell .subject-nav-shell { border-bottom:0; box-shadow:none; }

.dashboard {
  margin-top: 18rpx;
}

.subject-nav-sticky {
  position: relative;
  z-index: 25;
  margin: 0 -38rpx;
  padding: 0;
  background: rgba(251, 254, 253, .97);
  box-shadow: 0 10rpx 24rpx rgba(23, 82, 79, .045);
}

.subject-nav-shell {
  position: relative;
  height: 92rpx;
  display: flex;
  align-items: stretch;
  overflow: hidden;
  border-top: 0;
  border-bottom: 1rpx solid #e4efed;
  border-radius: 0;
  background: rgba(251, 254, 253, .97);
  box-shadow: 0 8rpx 24rpx rgba(0, 150, 145, .07);
}

.subject-scroll {
  min-width: 0;
  flex: 1;
  height: 92rpx;
  white-space: nowrap;
}

.subject-tabs {
  min-width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 12rpx 0 38rpx;
}

.subject-tab {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: auto;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 17rpx;
  color: #171b1c;
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
}

.subject-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #11c7b1, #03b9c5);
  font-weight: 700;
}

.subject-tab.active::after { display:none; }

.subject-settings {
  position: relative;
  z-index: 2;
  flex: none;
  width: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid #e7eeee;
  border-radius: 0;
  background: rgba(255,255,255,.98);
  box-shadow: -12rpx 0 18rpx rgba(22, 87, 83, .045);
}

.settings-sliders {
  width: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.settings-sliders > view {
  position: relative;
  height: 3rpx;
  border-radius: 3rpx;
  background: #617072;
}

.settings-sliders > view::after {
  content: '';
  position: absolute;
  top: -4rpx;
  width: 11rpx;
  height: 11rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #0aaaa4;
  box-shadow: 0 0 0 1rpx #0aaaa4;
}

.settings-sliders > view:nth-child(1)::after,
.settings-sliders > view:nth-child(3)::after { left: 6rpx; }
.settings-sliders > view:nth-child(2)::after { right: 5rpx; }

.subject-settings:active { background: #eef8f7; }

.home-refresh-feedback {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 12rpx 0 0;
  border-radius: 18rpx;
  color: #087f7a;
  background: linear-gradient(90deg, rgba(231,249,247,.35), rgba(231,249,247,.95), rgba(231,249,247,.35));
  font-size: 23rpx;
  animation: home-refresh-enter .18s ease-out;
}

.home-refresh-spinner {
  width: 29rpx;
  height: 29rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(8, 167, 160, .2);
  border-top-color: #08a7a0;
  border-radius: 50%;
  animation: home-refresh-spin .68s linear infinite;
}

.home-refresh-feedback.refresh-success { color:#138b68; background:#edf9f3; }
.home-refresh-check { width:29rpx; height:29rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#1ab58a; font-size:19rpx; font-weight:700; }

@keyframes home-refresh-spin { to { transform: rotate(360deg); } }
@keyframes home-refresh-enter {
  from { opacity:0; transform:translateY(-8rpx); }
  to { opacity:1; transform:translateY(0); }
}

.subject-modal-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(9, 23, 25, .48);
}

.subject-modal {
  width: 100%;
  max-width: 630rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 28rpx 80rpx rgba(0, 45, 43, .22);
}

.subject-modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 30rpx 22rpx;
  border-bottom: 1rpx solid #edf2f1;
}

.subject-modal-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.subject-modal-title { color: #142022; font-size: 34rpx; font-weight: 700; }
.subject-modal-subtitle { margin-top: 8rpx; color: #899496; font-size: 23rpx; }

.subject-modal-toolbar {
  height: 68rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38rpx;
  border-bottom: 1rpx solid #edf2f1;
  background: #f8fbfa;
}

.subject-selected-count {
  color: #7d898a;
  font-size: 23rpx;
}

.subject-modal-selectall {
  min-width: 104rpx;
  padding: 7rpx 14rpx;
  border-radius: 18rpx;
  color: #079c96;
  background: #e8f8f6;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}
.subject-modal-selectall:active { opacity: .6; }

.subject-choice-grid {
  height: 530rpx;
  box-sizing: border-box;
  padding: 14rpx 30rpx;
}

.subject-choice {
  min-width: 0;
  width: 100%;
  height: 62rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid #edf2f1;
  color: #485456;
  background: #fff;
  font-size: 26rpx;
}

.subject-choice.checked {
  color: #078f8a;
  font-weight: 600;
}

.subject-choice.dragging {
  position: relative;
  z-index: 2;
  border-radius: 15rpx;
  background: #e9f9f7;
  box-shadow: 0 8rpx 22rpx rgba(3, 147, 141, .16);
  transform: scale(1.015);
}

.subject-order-number {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #078f8a;
  background: #e9f9f7;
  font-size: 21rpx;
}

.subject-order-number.subject-order-placeholder { background: transparent; }
.subject-choice-name { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subject-drag-handle {
  flex: none;
  width: 54rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eef8f7;
}
.subject-drag-handle:active { background: #d9f0ed; }

.drag-dot-grid {
  width: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 5rpx 6rpx;
}

.drag-dot-grid text {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #458f8c;
}

.subject-checkbox {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #cbd6d5;
  border-radius: 9rpx;
  color: transparent;
  font-size: 22rpx;
  line-height: 1;
}

.subject-choice.checked .subject-checkbox {
  border-color: #0bb2a8;
  color: #fff;
  background: #0bb2a8;
}

.subject-modal-actions { display: flex; border-top: 1rpx solid #edf2f1; }
.subject-modal-button { flex: 1; height: 94rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.subject-modal-button.reset { color: #7c8789; border-right: 1rpx solid #edf2f1; }
.subject-modal-button.confirm { color: #079c96; }
.subject-modal-button:active { background: #f3f8f7; }

.summary {
  box-sizing: border-box;
  min-height: 256rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 46rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 48rpx rgba(0, 191, 180, 0.13);
}

.summary.loading {
  justify-content: center;
}

.summary-copy {
  min-width: 0;
  flex: 1;
}

.summary-title {
  color: #3e4447;
  font-size: 28rpx;
  font-weight: 400;
}

.summary-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.guest-data-badge {
  padding: 4rpx 11rpx;
  border-radius: 12rpx;
  color: #078f8a;
  background: #e4f8f5;
  font-size: 18rpx;
  line-height: 1.4;
}

.metrics {
  display: flex;
  align-items: flex-end;
}

.metric {
  min-width: 124rpx;
}

.metric-link {
  padding: 10rpx 8rpx;
  margin: -10rpx -8rpx;
  border-radius: 16rpx;
  transition: background-color .16s ease, transform .16s ease;
}

.metric-link:active { background:#eaf8f6; transform:scale(.97); }

.metric-label {
  display: block;
  color: #222729;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.metric-number {
  margin-top: 8rpx;
  color: #050606;
  font-size: 50rpx;
  font-weight: 500;
  line-height: 1;
}

.metric-unit {
  margin-left: 3rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.metric-separator {
  width: 1rpx;
  height: 76rpx;
  margin: 0 26rpx 0 20rpx;
  background: #e2e6e6;
}

.accuracy-ring {
  flex: none;
  width: 172rpx;
  height: 172rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8f8f7;
  box-shadow: inset 0 0 0 1rpx rgba(7, 159, 153, 0.04);
}

.accuracy-inner {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.72);
}

.accuracy-label {
  color: #33393b;
  font-size: 24rpx;
  line-height: 1.1;
}

.accuracy-number {
  margin-top: 3rpx;
  color: #030404;
  font-size: 45rpx;
  font-weight: 600;
  line-height: 1;
}

.actions {
  display: flex;
  gap: 30rpx;
  margin-top: 38rpx;
}

.action {
  flex: 1;
  height: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  border-radius: 28rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(0, 167, 180, 0.16);
}

.action-camera {
  background: linear-gradient(135deg, #31dca7 0%, #04b3dd 100%);
}

.action-recommend {
  background: linear-gradient(135deg, #ffc33f 0%, #ff5838 100%);
  box-shadow: 0 16rpx 36rpx rgba(255, 112, 49, 0.17);
}

.camera-icon {
  position: relative;
  width: 100rpx;
  height: 70rpx;
  border-radius: 10rpx;
  background: #fff;
}

.camera-icon::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: 22rpx;
  width: 48rpx;
  height: 22rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #fff;
}

.camera-lens {
  position: absolute;
  top: 13rpx;
  left: 30rpx;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  border: 7rpx solid #10b8c0;
  border-radius: 50%;
}

.camera-dot {
  position: absolute;
  top: 12rpx;
  right: 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #11b8bc;
}

.book-icon {
  position: relative;
  width: 108rpx;
  height: 84rpx;
}

.book-page {
  position: absolute;
  top: 0;
  box-sizing: border-box;
  width: 52%;
  height: 76rpx;
  border: 8rpx solid #fff;
  background: rgba(255, 255, 255, 0.08);
}

.book-page-left {
  left: 0;
  border-right-width: 4rpx;
  border-radius: 10rpx 0 8rpx 14rpx;
  transform: skewY(5deg);
}

.book-page-right {
  right: 0;
  border-left-width: 4rpx;
  border-radius: 0 10rpx 14rpx 8rpx;
  transform: skewY(-5deg);
}

.book-mark {
  position: absolute;
  top: 29rpx;
  right: 24rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: #fff;
  transform: rotate(-13deg);
}

.recent-card {
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 16rpx 46rpx rgba(0, 170, 164, 0.10);
}

.recent-header {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.header-arrow {
  color: #6f7679;
  font-family: Arial, sans-serif;
  font-weight: 300;
}

.header-arrow {
  font-size: 56rpx;
}

.recent-empty {
  padding: 70rpx 30rpx 90rpx;
  text-align: center;
  color: #899497;
  font-size: 26rpx;
}

.recent-row {
  position: relative;
  min-height: 116rpx;
  display: flex;
  align-items: center;
  margin: 0 38rpx;
  border-bottom: 1rpx solid #e8ecec;
}

.recent-row:last-child {
  border-bottom: 0;
}

.question-index {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #09aaa7;
  background: #eafbf8;
  font-size: 34rpx;
  font-weight: 500;
}

.question-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  padding: 22rpx 0;
}

.question-title-line {
  min-width: 0;
  display: flex;
  align-items: center;
}

.question-title {
  position: relative;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #101314;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.question-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  overflow: hidden;
  white-space: nowrap;
}

.mini-tag {
  flex: none;
  margin-right: 7rpx;
  padding: 2rpx 9rpx;
  border: 1rpx solid #87d7d0;
  border-radius: 5rpx;
  color: #16aaa5;
  font-size: 17rpx;
  line-height: 1.25;
}

.question-side {
  align-self: flex-start;
  flex: none;
  width: 72rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding-top: 30rpx;
}

.question-time {
  color: #8d9698;
  font-size: 20rpx;
}
